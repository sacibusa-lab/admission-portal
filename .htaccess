<IfModule mod_rewrite.c>
    RewriteEngine On

    # Disable directory listing
    Options -Indexes

    # Avoid directory/file search in root for sensitive files
    <FilesMatch "^(\.env|composer\.json|composer\.lock|package\.json|package-lock\.json|artisan|phpunit\.xml|vite\.config\.js)$">
        <IfModule mod_authz_core.c>
            Require all denied
        </IfModule>
        <IfModule !mod_authz_core.c>
            Order deny,allow
            Deny from all
        </IfModule>
    </FilesMatch>

    # Avoid infinite redirect loop
    RewriteCond %{REQUEST_URI} !^/public/

    # Rewrite all requests to the public directory
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>
