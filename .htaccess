<IfModule mod_rewrite.c>
    RewriteEngine On

    # Disable directory listing
    Options -Indexes

    # Block direct access to sensitive files in the root folder
    <FilesMatch "^(\.env|composer\.json|composer\.lock|package\.json|package-lock\.json|artisan|phpunit\.xml|vite\.config\.js)$">
        <IfModule mod_authz_core.c>
            Require all denied
        </IfModule>
        <IfModule !mod_authz_core.c>
            Order deny,allow
            Deny from all
        </IfModule>
    </FilesMatch>

    # Only rewrite if this is the initial request (prevents infinite loops in subfolders)
    RewriteCond %{ENV:REDIRECT_STATUS} ^$
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>
